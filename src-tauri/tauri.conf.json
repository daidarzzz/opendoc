{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDoc",
  "version": "0.2.76",
  "identifier": "com.opendoc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMjc3QjU0MzhBMEM0QUQKUldTdHhLQTRWSHNuVXl3TmxYNE5YWHRHYVBjbnNNL1FUVjlEcTQycHQ0Z00xQnNjb1NrZ3ZTbFoK",
      "endpoints": [
        "https://github.com/daidarzzz/opendoc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
